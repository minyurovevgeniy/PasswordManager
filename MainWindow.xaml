<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="MainWindow" Height="530" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ListView x:Name="commentsListView"  Grid.Column="0" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="270" VerticalAlignment="Top" Margin="5,5,5,5">
            <!--<ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View> -->
        </ListView>
        <ListView x:Name="passwordsListView" Grid.Column="1" Margin="5" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <!--<ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>-->
        </ListView>
        <Menu Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,1">
            <MenuItem Header="Файл">
                <MenuItem Header="Создать"/>
                <MenuItem x:Name="openMenuItem" Header="Открыть" Click="openMenuItem_Click"/>
                <MenuItem x:Name="saveMenuItem" Header="Сохранить" Click="saveMenuItem_Click"/>
                <MenuItem Header="Закрыть"/>
            </MenuItem>
            <MenuItem Header="Настройки" x:Name="Settings" Click="Settings_Click"/>
        </Menu>
        <Button Grid.Column="0" x:Name="action" Content="Добавить комментарий и пароль" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Center" Height="26" Width="207" Click="action_Click" />
        <TextBox x:Name="commentTextBox" Grid.Column="0" HorizontalAlignment="Center" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Margin="5" Width="410" Height="25"/>
        <TextBlock Grid.Column="0" Margin="92,0,92,0" Grid.Row="1" TextWrapping="Wrap" Text="Комментарии" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="Пароли" VerticalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" Text="Режим работы" VerticalAlignment="Top" Margin="22,9,0,0"/>
        <ComboBox x:Name="mode" HorizontalAlignment="Center" Grid.Column="0" Margin="0,10,0,0" Grid.Row="5" Width="208" Height="22" VerticalAlignment="Top" SelectionChanged="mode_SelectionChanged"/>
        <Button Height="25" Width="180" Grid.Column="1" x:Name="generate" Content="Генерировать пароль" HorizontalAlignment="Center" Margin="0,10,0,15" Grid.Row="4" RenderTransformOrigin="-0.833,0.69" Click="generate_Click"/>
        <TextBox x:Name="passwordTextBox" Grid.Column="1" HorizontalAlignment="Left" Margin="5" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="410" Height="25"/>
    </Grid>
</Window>
