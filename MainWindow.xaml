<Window x:Class="PasswordManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Background="#CCAF78"
        Title="MainWindow" Height="540" Width="850">
    <Window.Resources>
        <FontFamily x:Key="buttonFont">Verdana</FontFamily>
        <SolidColorBrush Color="White" x:Key="buttonFontColor" />
        <SolidColorBrush Color="#82CC78" x:Key="buttonBackColor" />
        <SolidColorBrush Color="#82CC78" x:Key="listTextColor" />
        <SolidColorBrush Color="#CCAF78" x:Key="formBackColor" />
        <SolidColorBrush Color="#789DCC" x:Key="menuBackColor" />
        <Thickness x:Key="buttonMargin" Bottom="10" Left="10" Top="10" Right="10" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Комментарии" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Текущий пароль" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ListView x:Name="passwordsListView" Grid.Column="1" Margin="5" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <!-- Text Metadata -->

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding comment}" FontWeight="Bold" FontSize="14" Foreground="#333333"/>
                            <!--<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding password}" FontSize="14" Foreground="#777777" Margin="0,2,0,0"/>-->
                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Menu Background="{StaticResource menuBackColor}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Margin="1">
            
            <MenuItem Header="Файл">
                <MenuItem Header="Создать"/>
                <MenuItem x:Name="openMenuItem" Header="Открыть" Click="openMenuItem_Click"/>
                <MenuItem x:Name="saveMenuItem" Header="Сохранить" Click="saveMenuItem_Click"/>
                <MenuItem Header="Закрыть"/>
            </MenuItem>
            <MenuItem Header="Настройки" x:Name="Settings" Click="Settings_Click"/>
        </Menu>
        <Button 
            FontFamily="{StaticResource buttonFont}"
                Foreground="{StaticResource buttonFontColor}"
                Background="{StaticResource buttonBackColor}"
                
            Grid.Column="0" x:Name="action" Content="Добавить комментарий и пароль" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Center" Height="26" Width="207" Click="action_Click" />

        <TextBox x:Name="commentTextBox" Grid.Column="0" HorizontalAlignment="Left" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Margin="5" Width="420" Height="25"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" Text="Режим работы" VerticalAlignment="Center" Margin="15,0,0,0"/>
        <ComboBox x:Name="mode" HorizontalAlignment="Center" Margin="0,14,0,14" Grid.Row="5" Width="208" Height="22" SelectionChanged="mode_SelectionChanged">

            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="LightBlue"/>
                </Style>
            </ComboBox.ItemContainerStyle>
            
        </ComboBox>
            
        <Button  
            Foreground="{StaticResource buttonFontColor}"
            Background="{StaticResource buttonBackColor}"
                 Height="25" Width="180" Grid.Column="1" x:Name="generate" Content="Генерировать пароль" HorizontalAlignment="Center" Margin="0,10,0,15" Grid.Row="4" RenderTransformOrigin="-0.833,0.69" Click="generate_Click"/>
        <TextBox x:Name="passwordTextBox" Grid.Column="1" Margin="6,0,6,0" Grid.Row="3" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="25" TextChanged="passwordTextBox_TextChanged"/>
        <PasswordBox Grid.Column="1" HorizontalAlignment="Left" Margin="83,0,0,0" Grid.Row="5" VerticalAlignment="Center" Width="120" TextInput="PasswordBox_TextInput"/>

    </Grid>
</Window>
