<Window x:Class="PasswordManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Настройки" Height="200" Width="200">
    <Grid VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="167"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Row="0" x:Name="AlphabetUpperCaseLetters" Content="A-Z" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="15" Width="39"/>
        <CheckBox x:Name="AlphabetLowerCaseLetters" Content="a-z" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="1" Height="15" Width="36"/>
        <CheckBox x:Name="Digits" Content="0-9" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.Row="2" Height="15" Width="38"/>
        <CheckBox x:Name="SpecialChars" Content="Специальные символы" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Height="16" Width="147"/>

        <Slider Grid.Row="5" x:Name="passwordLengthSlider" HorizontalAlignment="Left" Margin="5,5,5,5" VerticalAlignment="Top" Width="180" Minimum="2" Value="5" Maximum="10" ValueChanged="passwordLengthSlider_ValueChanged"/>
        <TextBlock Text="" x:Name="passwordLengthText" HorizontalAlignment="Center" Grid.Row="4" TextWrapping="Wrap" VerticalAlignment="Center" Width="156"/>
        <Button x:Name="save" Content="Сохранить" HorizontalAlignment="Left" Margin="80,2,0,3" Grid.Row="6" Click="save_Click"/>

    </Grid>
</Window>
