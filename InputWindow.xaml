<Window x:Class="PasswordManager.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Ввод пароля" Height="200" Width="350">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Введите строку:" Margin="0,0,0,8" FontWeight="SemiBold"/>
            <TextBox x:Name="InputTextBox" Height="26" Margin="0,0,0,12"/>
            <Button Content="Подтвердить" x:Name="ConfirmButton" Click="ConfirmButton_Click" IsDefault="True" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
