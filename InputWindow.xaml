<Window x:Class="PasswordManager.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        mc:Ignorable="d"
        Title="Ввод мастер-пароля" Height="200" Width="350">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Введите мастер-пароль:" Margin="0,0,0,8" FontWeight="SemiBold"/>
            
            <PasswordBox x:Name="masterPasswordBox" Width="318" Height="26" Margin="0,10,0,10"/>
            <Button Content="Подтвердить" x:Name="ConfirmButton" Click="ConfirmButton_Click" IsDefault="True" Padding="10,5"/>
            
        </StackPanel>
    </Grid>
</Window>
